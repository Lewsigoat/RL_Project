---
import Base from '../../layouts/Base.astro';
import Answer from '../../components/Answer.astro';
import { brands } from '../../data/brands.js';

export function getStaticPaths() {
  return brands.map((b) => ({ params: { slug: b.slug }, props: { brand: b } }));
}

const { brand } = Astro.props;
---
<Base title={`${brand.name} pressure washer fittings`} description={`${brand.name}: ${brand.typical} Measure before you buy a hose or gun.`} path={`/brands/${brand.slug}/`}>
  <div class="prose">
    <p class="crumbs"><a href="/">Home</a> / <a href="/brands/">Brands</a> / {brand.name}</p>
    <h1>{brand.name} fittings</h1>
    <Answer title="Starting point">
      {brand.typical}. Confidence: {brand.confidence}.
    </Answer>
    <h2>What to do anyway</h2>
    <p>{brand.measure}</p>
    <ul>
      {brand.notes.map((n) => <li>{n}</li>)}
    </ul>
    <h2>Source</h2>
    <p>{brand.source}</p>
    <p>Next: <a href="/measure-m22/">measure M22</a> · <a href="/adapters/">adapters</a> · <a href="/identify/">full walkthrough</a></p>
    <div class="callout">
      Not affiliated with {brand.name}. Model years change fittings without changing the logo.
    </div>
  </div>
</Base>
