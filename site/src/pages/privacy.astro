---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy policy" description="Privacy policy for Drill Chart, including cookies and advertising." path="/privacy/">
  <div class="prose">
    <p class="crumbs"><a href="/">Home</a> / Privacy</p>
    <h1>Privacy policy</h1>
    <p>Last updated 4 September 2026.</p>
    <p>Drill Chart is a static reference. There is no account system.</p>
    <h2>What we collect</h2>
    <ul>
      <li>CDN and host logs (IP, user agent, URL) for security.</li>
      <li>Aggregated analytics if Search Console or Cloudflare Web Analytics is enabled.</li>
      <li>Email you send to the contact address, kept long enough to answer.</li>
    </ul>
    <h2>Cookies and advertising</h2>
    <p>The site is built to carry Google AdSense after approval. Google may use cookies to serve and measure ads. Opt out of personalized ads at <a href="https://adssettings.google.com/">Google Ads Settings</a>.</p>
    <p>We do not sell an email list or a list of pages you read.</p>
  </div>
</Base>
