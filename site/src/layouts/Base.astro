---
import '../styles/global.css';
import { nav, footer } from '../data/nav.js';

const {
  title,
  description,
  path = '/',
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const pageTitle = title.includes('PW Fit Guide') ? title : `${title} — PW Fit Guide`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <!-- Google Search Console: replace content after verification -->
    <meta name="google-site-verification" content="REPLACE_WITH_GSC_TOKEN" />
    <slot name="head" />
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="logo" href="/">PW Fit<span>Guide</span></a>
        <nav class="primary" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <nav aria-label="Footer">
          {footer.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <p>Independent fitting reference. Not affiliated with Sun Joe, Kärcher, Ryobi, Simpson, AR Blue Clean, or their owners. Measure the stem — do not buy from the word “M22” alone.</p>
      </div>
    </footer>
  </body>
</html>
